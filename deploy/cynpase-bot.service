[Unit]
Description=cynpase-bot Local AI Hub for StackChan (Orange Pi 6 Plus)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xander
WorkingDirectory=/home/xander/Documents/portfolio/cynpase-bot
EnvironmentFile=-/home/xander/Documents/portfolio/cynpase-bot/.env
ExecStart=/home/xander/Documents/portfolio/cynpase-bot/target/release/cynpase-bot --bind-addr 0.0.0.0:8000
Restart=always
RestartSec=5
LimitNOFILE=65536
Environment=RUST_LOG=info,cynpase_bot=debug,tower_http=info

[Install]
WantedBy=multi-user.target
